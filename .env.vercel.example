# Settings for the site on Vercel. Vercel builds every push through its Git
# integration, so these go in the Vercel dashboard, not in GitHub:
# Vercel → social-awareness-hp → Settings → Environment Variables.
# Step by step: docs/FIREBASE_ON_VERCEL.md. Names only; never commit real values.

# Firebase web app settings for the doodle and Shabd Khoj leaderboards
# (Firebase console → Project settings → General → Your apps → Config).
# Not secret: they end up in the site's code; firestore.rules protects the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
