rules_version = '2';

// Visitors may read the doodle leaderboard and save their own best score,
// and read the Shabd Khoj streak leaderboard and count their own daily word.
// Nothing else in the database can be read or written from the site.
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidEntry(player) {
      let entry = request.resource.data;
      return entry.keys().hasOnly(['name', 'score', 'updatedAt'])
        && entry.keys().hasAll(['name', 'score', 'updatedAt'])
        && entry.name is string
        && entry.name.size() > 0
        && entry.name.size() <= 48
        && entry.name.matches('^[\\p{L}\\p{M}]+( [\\p{L}\\p{M}]+)*$')
        && entry.name.lower() == player
        && entry.score is int
        && entry.score >= 0
        && entry.score <= 1000
        && entry.updatedAt == request.time;
    }

    match /doodlePlayers/{player} {
      allow read: if true;
      allow create: if isValidEntry(player);
      allow update: if isValidEntry(player)
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    // Shabd Khoj streaks: one document per browser, named by a random id that
    // the browser keeps in a cookie. lastDay is the player's local day number
    // (days since 1 January 1970), which is within a day of the server's date
    // in every time zone. A streak can only start at 0 or 1, grow by one on
    // the next day, or start again; so it can never grow faster than one a day.
    function serverDay() {
      return math.floor(request.time.toMillis() / 86400000);
    }

    function isCurrentDay(day) {
      return day >= serverDay() - 1 && day <= serverDay() + 1;
    }

    function isStreakEntry(player) {
      let entry = request.resource.data;
      return player.matches('^[a-z0-9]{20}$')
        && entry.keys().hasOnly(['name', 'streak', 'lastDay', 'updatedAt'])
        && entry.keys().hasAll(['name', 'streak', 'lastDay', 'updatedAt'])
        && entry.name is string
        && entry.name.size() > 0
        && entry.name.size() <= 48
        && entry.name.matches('^[\\p{L}\\p{M}]+( [\\p{L}\\p{M}]+)*$')
        && entry.streak is int
        && entry.streak >= 0
        && entry.lastDay is int
        && entry.updatedAt == request.time;
    }

    function isNextResult(entry, saved) {
      return isCurrentDay(entry.lastDay)
        && entry.lastDay > saved.lastDay
        && (entry.streak <= 1
          || (entry.lastDay == saved.lastDay + 1 && entry.streak == saved.streak + 1));
    }

    match /wordStreaks/{player} {
      allow read: if true;
      allow create: if isStreakEntry(player)
        && request.resource.data.streak <= 1
        && isCurrentDay(request.resource.data.lastDay);
      // A new name with the same streak, or the result of a later day.
      allow update: if isStreakEntry(player)
        && ((request.resource.data.streak == resource.data.streak
            && request.resource.data.lastDay == resource.data.lastDay)
          || isNextResult(request.resource.data, resource.data));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
