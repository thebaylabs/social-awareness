# Firebase web settings for the doodle / Shabd Khoj leaderboards
# (Firebase console → Project settings → Your apps → Web app).
# Copy this file to .env.local and fill it in.
# These values are not secret: they end up in the site's code, and
# firestore.rules is what protects the data.
# Without them, the dev server keeps scores in memory and a production build
# shows "The leaderboard is not set up yet".
API_KEY=
PROJECT_ID=
AUTH_DOMAIN=
APP_ID=

# Diya inauguration progress needs no cloud settings.
# Control the shared count at /admin (not linked from the site).
